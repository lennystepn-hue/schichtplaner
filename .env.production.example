# =============================================================================
# Schichtplaner – Umgebungsvariablen
# =============================================================================
# 1. Diese Datei nach .env kopieren
# 2. Alle CHANGE_ME-Werte ersetzen (Zufallswerte z. B. mit: openssl rand -base64 32)
# Die .env-Datei niemals weitergeben oder einchecken.

# --- Datenbank ---
POSTGRES_PASSWORD="CHANGE_ME_LANGES_ZUFALLSPASSWORT"

# --- Anmeldung ---
AUTH_SECRET="CHANGE_ME_ZUFALLSWERT_MIN_32_ZEICHEN"

# --- Adresse ---
# Nur im Firmennetz/VPN: "localhost" oder interner Hostname
DOMAIN="localhost"
APP_URL="https://localhost"

# --- Datenschutz-Schalter ---
# KI-Funktionen senden Daten an Anthropic (USA). Standard: aus.
AI_ENABLED="false"
# ANTHROPIC_API_KEY=""

# Registrierung ist nur fuer die Ersteinrichtung offen (solange keine Firma existiert).
# Danach legen Admins die Mitarbeiter an. Nur fuer Sonderfaelle auf "true" setzen.
ALLOW_REGISTRATION="false"
